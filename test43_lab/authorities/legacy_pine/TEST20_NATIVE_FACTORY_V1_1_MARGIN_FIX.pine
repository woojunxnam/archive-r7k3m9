//@version=6
strategy("TEST20 Native Factory V1.1 | VWAP Ensemble Stacking | Margin Fix | 5m", overlay=true, pyramiding=3, process_orders_on_close=false,
     initial_capital=10000000, default_qty_type=strategy.fixed, default_qty_value=1,
     margin_long=100, margin_short=100,
     commission_type=strategy.commission.cash_per_contract, commission_value=2.24, slippage=1, close_entries_rule="ANY")
string TZ = "America/New_York"
string RTH = "0930-1545:23456"
string target = syminfo.root
int tfSec = timeframe.in_seconds()

if barstate.isfirst and tfSec != 300
    runtime.error("TEST19 requires exactly 5-minute chart.")
if barstate.isfirst and syminfo.session != "us_regular"
    runtime.error("TEST19 requires chart Session = Regular Trading Hours.")
if barstate.isfirst and (target != "ES" and target != "NQ" and target != "RTY" and target != "YM" and target != "GC" and target != "SI" and target != "CL")
    runtime.error("TEST19 supports ES/NQ/RTY/YM/GC/SI/CL only.")

bool inRth = not na(time(timeframe.period, RTH, TZ))
int hh = hour(time, TZ)
int mm = minute(time, TZ)
int mod = hh * 60 + mm
bool firstRth = inRth and hh == 9 and mm == 30
bool flattenNow = inRth and hour(time_close, TZ) == 15 and minute(time_close, TZ) == 45
bool signalWindow = inRth and mod >= 600 and mod < 870

// Prior completed RTH ATR14.
var float activeHigh = na
var float activeLow = na
var float activeClose = na
var float prevSessClose = na
var float atr14 = na
var int atrCount = 0
var int rthBarCount = 0

if firstRth
    if not na(activeHigh) and not na(activeLow) and not na(activeClose)
        float trPrev = na(prevSessClose) ? activeHigh - activeLow : math.max(activeHigh - activeLow, math.max(math.abs(activeHigh - prevSessClose), math.abs(activeLow - prevSessClose)))
        atr14 := na(atr14) ? trPrev : (atr14 * 13.0 + trPrev) / 14.0
        atrCount += 1
        prevSessClose := activeClose
    activeHigh := high
    activeLow := low
    activeClose := close
    rthBarCount := 1
else if inRth
    rthBarCount += 1
    activeHigh := math.max(nz(activeHigh, high), high)
    activeLow := math.min(nz(activeLow, low), low)
    activeClose := close

float atrPrev = atrCount >= 14 ? atr14 : na

// RTH / weekly / monthly VWAP.
var float cumV = 0.0
var float cumPV = 0.0
var float cumPV2 = 0.0
var float lastSessionVwap = na
var float prevDayVwap = na
var float weekV = 0.0
var float weekPV = 0.0
var float monthV = 0.0
var float monthPV = 0.0
var int prevMonth = na

float tp = hlc3
if firstRth
    prevDayVwap := lastSessionVwap
    cumV := 0.0
    cumPV := 0.0
    cumPV2 := 0.0
    if dayofweek == dayofweek.monday
        weekV := 0.0
        weekPV := 0.0
    int curMonth = month(time, TZ)
    if na(prevMonth) or curMonth != prevMonth
        monthV := 0.0
        monthPV := 0.0
    prevMonth := curMonth

if inRth
    cumV += nz(volume)
    cumPV += tp * nz(volume)
    cumPV2 += tp * tp * nz(volume)
    weekV += nz(volume)
    weekPV += tp * nz(volume)
    monthV += nz(volume)
    monthPV += tp * nz(volume)

float vwap = inRth and cumV > 0 ? cumPV / cumV : na
float variance = inRth and cumV > 0 ? math.max(cumPV2 / cumV - vwap * vwap, 0.0) : na
float vwapSd = not na(variance) ? math.sqrt(variance) : na
float wvwap = inRth and weekV > 0 ? weekPV / weekV : na
float mvwap = inRth and monthV > 0 ? monthPV / monthV : na
if inRth and not na(vwap)
    lastSessionVwap := vwap

float distAtr = inRth and not na(atrPrev) and atrPrev > 0 ? (close - vwap) / atrPrev : na
float slope6Atr = inRth and rthBarCount > 6 and not na(atrPrev) and atrPrev > 0 ? (vwap - vwap[6]) / atrPrev : na
float accel3Atr = inRth and rthBarCount > 9 and not na(slope6Atr[3]) ? slope6Atr - slope6Atr[3] : na
float curvatureAtr = inRth and rthBarCount > 6 and not na(atrPrev) and atrPrev > 0 ? (vwap - 2.0 * vwap[3] + vwap[6]) / atrPrev : na
float bandWidthAtr = inRth and not na(atrPrev) and atrPrev > 0 and not na(vwapSd) ? vwapSd / atrPrev : na
float bandWidthRatio6 = inRth and rthBarCount > 6 and not na(bandWidthAtr[6]) and bandWidthAtr[6] > 0 ? bandWidthAtr / bandWidthAtr[6] : na
float prior12MinAt6 = inRth and rthBarCount > 19 ? ta.lowest(bandWidthAtr[7], 12) : na
float pressure12 = inRth and rthBarCount >= 12 ? math.sum(distAtr, 12) : na

int side = not inRth or na(vwap) ? 0 : close > vwap ? 1 : close < vwap ? -1 : 0
bool crossUp = inRth and not firstRth and side == 1 and side[1] <= 0
bool crossDown = inRth and not firstRth and side == -1 and side[1] >= 0
bool crossEvent = crossUp or crossDown

var int crossAge = 0
var int signedStreak = 0
if firstRth
    crossAge := 0
    signedStreak := side
else if inRth
    crossAge := crossEvent ? 0 : crossAge + 1
    if side > 0
        signedStreak := signedStreak > 0 ? signedStreak + 1 : 1
    else if side < 0
        signedStreak := signedStreak < 0 ? signedStreak - 1 : -1
    else
        signedStreak := 0

// Post-10:00 VWAP touch memory.
bool touch = inRth and not na(vwap) and low <= vwap and high >= vwap
bool prevPost10Touch = inRth[1] and mod[1] >= 600 and touch[1]
bool newPost10Touch = signalWindow and touch and not prevPost10Touch
var int post10TouchCount = 0
if firstRth
    post10TouchCount := 0
if newPost10Touch
    post10TouchCount += 1

// Reclaim -> hold -> retest state machines.
var bool longReclaimActive = false
var bool shortReclaimActive = false
var int longHoldBars = 0
var int shortHoldBars = 0
bool reclaimRetestLong = false
bool reclaimRetestShort = false

if firstRth
    longReclaimActive := false
    shortReclaimActive := false
    longHoldBars := 0
    shortHoldBars := 0

if signalWindow
    if crossUp
        longReclaimActive := true
        longHoldBars := 0
    else if longReclaimActive
        if side > 0
            longHoldBars += 1
            if longHoldBars >= 2 and low <= vwap and close > vwap and close > open
                reclaimRetestLong := true
                longReclaimActive := false
        else
            longReclaimActive := false

    if crossDown
        shortReclaimActive := true
        shortHoldBars := 0
    else if shortReclaimActive
        if side < 0
            shortHoldBars += 1
            if shortHoldBars >= 2 and high >= vwap and close < vwap and close < open
                reclaimRetestShort := true
                shortReclaimActive := false
        else
            shortReclaimActive := false

bool acceptanceFailLong = signalWindow and rthBarCount >= 3 and signedStreak[2] <= -12 and crossUp[1] and side > 0
bool acceptanceFailShort = signalWindow and rthBarCount >= 3 and signedStreak[2] >= 12 and crossDown[1] and side < 0

bool squeezeReleaseLong = signalWindow and rthBarCount > 19 and not na(prior12MinAt6) and prior12MinAt6 > 0 and bandWidthAtr[6] <= prior12MinAt6 * 1.10 and bandWidthRatio6 >= 1.25 and side > 0 and slope6Atr >= 0
bool squeezeReleaseShort = signalWindow and rthBarCount > 19 and not na(prior12MinAt6) and prior12MinAt6 > 0 and bandWidthAtr[6] <= prior12MinAt6 * 1.10 and bandWidthRatio6 >= 1.25 and side < 0 and slope6Atr <= 0

// Rolling RTH VWAP term structure.
float pv = tp * nz(volume)
float rvwap30 = inRth and rthBarCount >= 6 ? math.sum(pv, 6) / math.sum(nz(volume), 6) : na
float rvwap60 = inRth and rthBarCount >= 12 ? math.sum(pv, 12) / math.sum(nz(volume), 12) : na
float rvwap120 = inRth and rthBarCount >= 24 ? math.sum(pv, 24) / math.sum(nz(volume), 24) : na
float term30v120Atr = inRth and not na(rvwap120) and not na(atrPrev) and atrPrev > 0 ? (rvwap30 - rvwap120) / atrPrev : na

float sessionWeekAtr = inRth and not na(atrPrev) and atrPrev > 0 ? (vwap - wvwap) / atrPrev : na
float weekMonthAtr = inRth and not na(atrPrev) and atrPrev > 0 ? (wvwap - mvwap) / atrPrev : na
float sessionMigrationAtr = inRth and not na(prevDayVwap) and not na(atrPrev) and atrPrev > 0 ? (vwap - prevDayVwap) / atrPrev : na

// Cross-index VWAP breadth.
f_rth_side() =>
    bool _in = not na(time(timeframe.period, RTH, TZ))
    bool _first = _in and hour(time, TZ) == 9 and minute(time, TZ) == 30
    var float _v = 0.0
    var float _pv = 0.0
    if _first
        _v := 0.0
        _pv := 0.0
    if _in
        _v += nz(volume)
        _pv += hlc3 * nz(volume)
    float _vw = _in and _v > 0 ? _pv / _v : na
    _in and not na(_vw) ? close > _vw ? 1 : close < _vw ? -1 : 0 : 0

int esSide = request.security("CME_MINI:ES1!", "5", f_rth_side(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int nqSide = request.security("CME_MINI:NQ1!", "5", f_rth_side(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int rtySide = request.security("CME_MINI:RTY1!", "5", f_rth_side(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int ymSide = request.security("CBOT_MINI:YM1!", "5", f_rth_side(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int breadthUp = (esSide > 0 ? 1 : 0) + (nqSide > 0 ? 1 : 0) + (rtySide > 0 ? 1 : 0) + (ymSide > 0 ? 1 : 0)

// 30-minute Opening Range event AVWAP.
var float orHigh = na
var float orLow = na
var bool longEvent = false
var bool shortEvent = false
var float longEventV = 0.0
var float longEventPV = 0.0
var float shortEventV = 0.0
var float shortEventPV = 0.0
var int longEventAge = na
var int shortEventAge = na

if firstRth
    orHigh := high
    orLow := low
    longEvent := false
    shortEvent := false
    longEventV := 0.0
    longEventPV := 0.0
    shortEventV := 0.0
    shortEventPV := 0.0
    longEventAge := na
    shortEventAge := na
else if inRth and mod < 600
    orHigh := math.max(orHigh, high)
    orLow := math.min(orLow, low)

bool longEventStart = inRth and mod >= 600 and not longEvent and not na(orHigh) and close > orHigh
bool shortEventStart = inRth and mod >= 600 and not shortEvent and not na(orLow) and close < orLow

if longEventStart
    longEvent := true
    longEventV := nz(volume)
    longEventPV := tp * nz(volume)
    longEventAge := 0
else if inRth and longEvent
    longEventV += nz(volume)
    longEventPV += tp * nz(volume)
    longEventAge += 1

if shortEventStart
    shortEvent := true
    shortEventV := nz(volume)
    shortEventPV := tp * nz(volume)
    shortEventAge := 0
else if inRth and shortEvent
    shortEventV += nz(volume)
    shortEventPV += tp * nz(volume)
    shortEventAge += 1

float longEventVwap = longEvent and longEventV > 0 ? longEventPV / longEventV : na
float shortEventVwap = shortEvent and shortEventV > 0 ? shortEventPV / shortEventV : na
float longEventDistAtr = inRth and not na(longEventVwap) and not na(atrPrev) and atrPrev > 0 ? (close - longEventVwap) / atrPrev : na
float shortEventDistAtr = inRth and not na(shortEventVwap) and not na(atrPrev) and atrPrev > 0 ? (close - shortEventVwap) / atrPrev : na

// Same-time-of-day RVOL: prior 20 completed sessions only.
const int SLOTS = 75
const int DAYS = 20
var array<float> slotSum = array.new_float(SLOTS, 0.0)
var array<int> slotCount = array.new_int(SLOTS, 0)
var array<float> ring = array.new_float(SLOTS * DAYS, na)
var int dayPtr = -1

if firstRth
    dayPtr := (dayPtr + 1) % DAYS
    for s = 0 to SLOTS - 1
        int ri = dayPtr * SLOTS + s
        float old = array.get(ring, ri)
        if not na(old)
            array.set(slotSum, s, array.get(slotSum, s) - old)
            array.set(slotCount, s, math.max(0, array.get(slotCount, s) - 1))
            array.set(ring, ri, na)

int slot = inRth ? int((mod - 570) / 5) : -1
float rvolAtTime = na
if inRth and slot >= 0 and slot < SLOTS
    int cnt = array.get(slotCount, slot)
    float avgPrior = cnt >= 5 ? array.get(slotSum, slot) / cnt : na
    rvolAtTime := not na(avgPrior) and avgPrior > 0 ? volume / avgPrior : na
    int ri = dayPtr * SLOTS + slot
    array.set(ring, ri, volume)
    array.set(slotSum, slot, array.get(slotSum, slot) + volume)
    array.set(slotCount, slot, array.get(slotCount, slot) + 1)

bool ready = signalWindow and not na(atrPrev) and atrPrev > 0 and not na(vwap) and not na(vwapSd)


// TEST18-only frozen derived features.
float z18 = inRth and not na(vwapSd) and vwapSd > 0 ? (close - vwap) / vwapSd : na
float spreadChange3Atr18 = inRth and rthBarCount > 3 and not na(atrPrev) and atrPrev > 0 ? ((close - vwap) - (close[3] - vwap[3])) / atrPrev : na
float cross12_18 = inRth and rthBarCount >= 12 ? math.sum(crossEvent ? 1.0 : 0.0, 12) : na
float aboveFrac12_18 = inRth and rthBarCount >= 12 ? math.sum(side > 0 ? 1.0 : 0.0, 12) / 12.0 : na
float belowFrac12_18 = inRth and rthBarCount >= 12 ? math.sum(side < 0 ? 1.0 : 0.0, 12) / 12.0 : na
bool failedBearBreak18 = signalWindow and rthBarCount >= 4 and crossUp and (((side[1] == -1) and (side[2] == 1)) or ((side[1] == -1) and (side[2] == -1) and (side[3] == 1)))
bool failedBullReclaim18 = signalWindow and rthBarCount >= 4 and crossDown and (((side[1] == 1) and (side[2] == -1)) or ((side[1] == 1) and (side[2] == 1) and (side[3] == -1)))
float prevCloseSameSession18 = rthBarCount > 1 ? close[1] : na

// Frozen TEST18 signals, copied without threshold changes.
bool e18_01 = ready and rthBarCount >= 13 and crossUp and belowFrac12_18[1] >= 10.0/12.0
bool e18_02 = ready and rthBarCount >= 13 and crossDown and aboveFrac12_18[1] >= 10.0/12.0
bool e18_03 = ready and signedStreak == 8 and slope6Atr >= 0.04
bool e18_04 = ready and signedStreak == -8 and slope6Atr <= -0.04
bool e18_05 = ready and failedBearBreak18
bool e18_06 = ready and failedBullReclaim18
bool e18_07 = ready and cross12_18 >= 3 and z18 <= -1.0 and close > open
bool e18_08 = ready and cross12_18 >= 3 and z18 >= 1.0 and close < open
bool e18_09 = ready and cross12_18 <= 1 and aboveFrac12_18 >= 10.0/12.0 and z18 >= 1.0 and z18 <= 2.0 and slope6Atr >= 0.04 and close > open
bool e18_10 = ready and cross12_18 <= 1 and belowFrac12_18 >= 10.0/12.0 and z18 <= -1.0 and z18 >= -2.0 and slope6Atr <= -0.04 and close < open
bool e18_11 = ready and z18 <= -1.6 and close > open and spreadChange3Atr18 >= 0.03
bool e18_12 = ready and z18 >= 1.6 and close < open and spreadChange3Atr18 <= -0.03
bool e18_13 = ready and z18 >= 2.0 and slope6Atr >= 0.07 and close > open and close > high[1]
bool e18_14 = ready and z18 <= -2.0 and slope6Atr <= -0.07 and close < open and close < low[1]
bool e18_15 = ready and distAtr >= 0 and distAtr <= 0.10 and slope6Atr >= 0.04 and close > open
bool e18_16 = ready and distAtr <= 0 and distAtr >= -0.10 and slope6Atr <= -0.04 and close < open
bool e18_17 = ready and rthBarCount > 3 and distAtr <= -0.10 and distAtr[1] <= -0.25 and spreadChange3Atr18 >= 0.10 and close > open
bool e18_18 = ready and rthBarCount > 3 and distAtr >= 0.10 and distAtr[1] >= 0.25 and spreadChange3Atr18 <= -0.10 and close < open
bool e18_19 = ready and distAtr >= 0.20 and spreadChange3Atr18 >= 0.10 and slope6Atr >= 0.04 and close > open
bool e18_20 = ready and distAtr <= -0.20 and spreadChange3Atr18 <= -0.10 and slope6Atr <= -0.04 and close < open
bool e18_21 = ready and signedStreak[1] >= 12 and low <= vwap and close > vwap and close > open
bool e18_22 = ready and signedStreak[1] <= -12 and high >= vwap and close < vwap and close < open
bool e18_23 = ready and rthBarCount > 1 and z18[1] <= -1.5 and z18 > -1.0 and close > open
bool e18_24 = ready and rthBarCount > 1 and z18[1] >= 1.5 and z18 < 1.0 and close < open
bool e18_25 = ready and crossUp and close > wvwap and vwap > wvwap and slope6Atr >= 0
bool e18_26 = ready and crossDown and close < wvwap and vwap < wvwap and slope6Atr <= 0
bool e18_27 = ready and not na(prevDayVwap) and not na(prevCloseSameSession18) and prevCloseSameSession18 <= prevDayVwap and close > prevDayVwap and close > vwap and slope6Atr >= 0
bool e18_28 = ready and not na(prevDayVwap) and not na(prevCloseSameSession18) and prevCloseSameSession18 >= prevDayVwap and close < prevDayVwap and close < vwap and slope6Atr <= 0
// Frozen TEST19 signals.
bool e19_01 = ready and side > 0 and slope6Atr >= 0.015 and accel3Atr >= 0.020 and curvatureAtr >= 0.008
bool e19_02 = ready and side < 0 and slope6Atr <= -0.015 and accel3Atr <= -0.020 and curvatureAtr <= -0.008
bool e19_03 = ready and side > 0 and slope6Atr >= 0 and bandWidthRatio6 >= 1.50
bool e19_04 = ready and side < 0 and slope6Atr <= 0 and bandWidthRatio6 >= 1.50
bool e19_05 = ready and squeezeReleaseLong
bool e19_06 = ready and squeezeReleaseShort
bool e19_07 = ready and pressure12 >= 2.50 and side > 0 and slope6Atr >= 0
bool e19_08 = ready and pressure12 <= -2.50 and side < 0 and slope6Atr <= 0
bool e19_09 = ready and crossAge == 18 and side > 0 and slope6Atr >= 0
bool e19_10 = ready and crossAge == 18 and side < 0 and slope6Atr <= 0
bool e19_11 = ready and newPost10Touch and (post10TouchCount == 2 or post10TouchCount == 3) and side > 0 and close > open and slope6Atr >= 0
bool e19_12 = ready and newPost10Touch and (post10TouchCount == 2 or post10TouchCount == 3) and side < 0 and close < open and slope6Atr <= 0
bool e19_13 = ready and reclaimRetestLong
bool e19_14 = ready and reclaimRetestShort
bool e19_15 = ready and acceptanceFailLong
bool e19_16 = ready and acceptanceFailShort
bool e19_17 = ready and breadthUp == 4 and breadthUp[1] <= 3 and side > 0 and slope6Atr >= 0 and distAtr <= 0.20
bool e19_18 = ready and breadthUp == 0 and breadthUp[1] >= 1 and side < 0 and slope6Atr <= 0 and distAtr >= -0.20
bool e19_19 = ready and sessionMigrationAtr >= 0.40 and side > 0 and slope6Atr >= 0
bool e19_20 = ready and sessionMigrationAtr <= -0.40 and side < 0 and slope6Atr <= 0
bool e19_21 = ready and close > vwap and vwap > wvwap and wvwap > mvwap and sessionWeekAtr >= 0.10 and weekMonthAtr >= 0.10
bool e19_22 = ready and close < vwap and vwap < wvwap and wvwap < mvwap and sessionWeekAtr <= -0.10 and weekMonthAtr <= -0.10
bool e19_23 = ready and rvwap30 > rvwap60 and rvwap60 > rvwap120 and term30v120Atr >= 0.15
bool e19_24 = ready and rvwap30 < rvwap60 and rvwap60 < rvwap120 and term30v120Atr <= -0.15
bool e19_25 = ready and longEventAge >= 3 and longEventDistAtr >= 0 and longEventDistAtr <= 0.03 and low <= longEventVwap + 0.02 * atrPrev and close > open
bool e19_26 = ready and shortEventAge >= 3 and shortEventDistAtr <= 0 and shortEventDistAtr >= -0.03 and high >= shortEventVwap - 0.02 * atrPrev and close < open
bool e19_27 = ready and crossUp and rvolAtTime >= 1.50
bool e19_28 = ready and crossDown and rvolAtTime >= 1.50


const int LEGS = 3
const int FAMS = 28
const int CONFIRM_MS = 30 * 60 * 1000

var array<bool> modSig = array.new_bool()
var array<int> modDir = array.new_int()
var array<int> modFam = array.new_int()
var array<bool> modSurv = array.new_bool()
var array<string> modName = array.new_string()
array.clear(modSig)
array.clear(modDir)
array.clear(modFam)
array.clear(modSurv)
array.clear(modName)
if target == "ES"
    array.push(modSig, e18_02)
    array.push(modDir, -1)
    array.push(modFam, 0)
    array.push(modSurv, true)
    array.push(modName, "T18-02")
    array.push(modSig, e18_14)
    array.push(modDir, -1)
    array.push(modFam, 6)
    array.push(modSurv, false)
    array.push(modName, "T18-14")
    array.push(modSig, e18_15)
    array.push(modDir, 1)
    array.push(modFam, 7)
    array.push(modSurv, true)
    array.push(modName, "T18-15")
    array.push(modSig, e18_21)
    array.push(modDir, 1)
    array.push(modFam, 10)
    array.push(modSurv, false)
    array.push(modName, "T18-21")
    array.push(modSig, e19_01)
    array.push(modDir, 1)
    array.push(modFam, 14)
    array.push(modSurv, true)
    array.push(modName, "T19-01")
    array.push(modSig, e19_06)
    array.push(modDir, -1)
    array.push(modFam, 16)
    array.push(modSurv, true)
    array.push(modName, "T19-06")
    array.push(modSig, e19_07)
    array.push(modDir, 1)
    array.push(modFam, 17)
    array.push(modSurv, true)
    array.push(modName, "T19-07")
    array.push(modSig, e19_13)
    array.push(modDir, 1)
    array.push(modFam, 20)
    array.push(modSurv, true)
    array.push(modName, "T19-13")
    array.push(modSig, e19_16)
    array.push(modDir, -1)
    array.push(modFam, 21)
    array.push(modSurv, true)
    array.push(modName, "T19-16")
if target == "NQ"
    array.push(modSig, e18_03)
    array.push(modDir, 1)
    array.push(modFam, 1)
    array.push(modSurv, false)
    array.push(modName, "T18-03")
    array.push(modSig, e18_05)
    array.push(modDir, 1)
    array.push(modFam, 2)
    array.push(modSurv, false)
    array.push(modName, "T18-05")
    array.push(modSig, e18_07)
    array.push(modDir, 1)
    array.push(modFam, 3)
    array.push(modSurv, true)
    array.push(modName, "T18-07")
    array.push(modSig, e18_09)
    array.push(modDir, 1)
    array.push(modFam, 4)
    array.push(modSurv, true)
    array.push(modName, "T18-09")
    array.push(modSig, e18_20)
    array.push(modDir, -1)
    array.push(modFam, 9)
    array.push(modSurv, false)
    array.push(modName, "T18-20")
    array.push(modSig, e18_23)
    array.push(modDir, 1)
    array.push(modFam, 11)
    array.push(modSurv, true)
    array.push(modName, "T18-23")
    array.push(modSig, e18_28)
    array.push(modDir, -1)
    array.push(modFam, 13)
    array.push(modSurv, true)

var array<bool> familySeenLong = array.new_bool(FAMS, false)
var array<bool> familySeenShort = array.new_bool(FAMS, false)
var array<bool> barAnyLong = array.new_bool(FAMS, false)
var array<bool> barAnyShort = array.new_bool(FAMS, false)
var array<bool> barSurvLong = array.new_bool(FAMS, false)
var array<bool> barSurvShort = array.new_bool(FAMS, false)
var array<int> lastAnyLong = array.new_int(FAMS, na)
var array<int> lastAnyShort = array.new_int(FAMS, na)
var array<int> lastSurvLong = array.new_int(FAMS, na)
var array<int> lastSurvShort = array.new_int(FAMS, na)

if firstRth
    for f = 0 to FAMS - 1
        array.set(familySeenLong, f, false)
        array.set(familySeenShort, f, false)
        array.set(lastAnyLong, f, na)
        array.set(lastAnyShort, f, na)
        array.set(lastSurvLong, f, na)
        array.set(lastSurvShort, f, na)

for f = 0 to FAMS - 1
    array.set(barAnyLong, f, false)
    array.set(barAnyShort, f, false)
    array.set(barSurvLong, f, false)
    array.set(barSurvShort, f, false)

if signalWindow and not session.islastbar
    for i = 0 to array.size(modSig) - 1
        if array.get(modSig, i)
            int d = array.get(modDir, i)
            int fam = array.get(modFam, i)
            bool surv = array.get(modSurv, i)
            if d == 1 and not array.get(familySeenLong, fam)
                array.set(familySeenLong, fam, true)
                array.set(barAnyLong, fam, true)
                if surv
                    array.set(barSurvLong, fam, true)
            if d == -1 and not array.get(familySeenShort, fam)
                array.set(familySeenShort, fam, true)
                array.set(barAnyShort, fam, true)
                if surv
                    array.set(barSurvShort, fam, true)

for f = 0 to FAMS - 1
    if array.get(barAnyLong, f)
        array.set(lastAnyLong, f, time)
    if array.get(barAnyShort, f)
        array.set(lastAnyShort, f, time)
    if array.get(barSurvLong, f)
        array.set(lastSurvLong, f, time)
    if array.get(barSurvShort, f)
        array.set(lastSurvShort, f, time)

string variant = input.string("V2_HIERARCHICAL_STACK_3X", "Architecture",
     options=["V0_SURVIVOR_UNION_1X","V1_SURVIVOR_STACK_3X","V2_HIERARCHICAL_STACK_3X","V3_CONSENSUS_2FAM_STACK_3X"])

int variantCode = variant == "V0_SURVIVOR_UNION_1X" ? 0 :
                  variant == "V1_SURVIVOR_STACK_3X" ? 1 :
                  variant == "V2_HIERARCHICAL_STACK_3X" ? 2 : 3

var bool campaignStartedToday = false
var int campaignDir = 0
var int campaignStartTime = na
var array<int> nLegsCreated = array.new_int(1, 0)
var array<bool> usedFamNative = array.new_bool(FAMS, false)
var array<float> legStopNative = array.new_float(LEGS, na)
var array<int> legDirNative = array.new_int(LEGS, 0)
var int latestOrderBar = na

if firstRth
    campaignStartedToday := false
    campaignDir := 0
    campaignStartTime := na
    array.set(nLegsCreated, 0, 0)
    latestOrderBar := na
    for f = 0 to FAMS - 1
        array.set(usedFamNative, f, false)
    for l = 0 to LEGS - 1
        array.set(legStopNative, l, na)
        array.set(legDirNative, l, 0)

// Aggregate current-bar survivor evidence.
int survLongCountN = 0
int survShortCountN = 0
for f = 0 to FAMS - 1
    survLongCountN += array.get(barSurvLong, f) ? 1 : 0
    survShortCountN += array.get(barSurvShort, f) ? 1 : 0

int stopTicksNative = not na(atrPrev) and atrPrev > 0 ? math.max(1, int(math.ceil(2.0 * atrPrev / syminfo.mintick))) : 0
float stopDistNative = stopTicksNative * syminfo.mintick

// Per-bar order intents. 0=no order, +1 long, -1 short.
var array<int> placeDir = array.new_int(LEGS, 0)
var array<int> placeFam = array.new_int(LEGS, -1)
for l = 0 to LEGS - 1
    array.set(placeDir, l, 0)
    array.set(placeFam, l, -1)

f_queue_native_leg(int dir, int fam, float sd) =>
    int created = array.get(nLegsCreated, 0)
    if created < LEGS
        array.set(placeDir, created, dir)
        array.set(placeFam, created, fam)
        array.set(legStopNative, created, sd)
        array.set(legDirNative, created, dir)
        if fam >= 0
            array.set(usedFamNative, fam, true)
        array.set(nLegsCreated, 0, created + 1)

// Start V0/V1/V2.
if ready and stopTicksNative > 0 and not campaignStartedToday and variantCode <= 2
    if survLongCountN > 0 and survShortCountN == 0
        campaignStartedToday := true
        campaignDir := 1
        campaignStartTime := time
        if variantCode == 0
            bool done = false
            for f = 0 to FAMS - 1
                if not done and array.get(barSurvLong, f)
                    f_queue_native_leg(1, f, stopDistNative)
                    done := true
        if variantCode == 1
            for f = 0 to FAMS - 1
                if array.get(nLegsCreated, 0) < LEGS and array.get(barSurvLong, f)
                    f_queue_native_leg(1, f, stopDistNative)
        if variantCode == 2
            for f = 0 to FAMS - 1
                if array.get(nLegsCreated, 0) < LEGS and array.get(barSurvLong, f)
                    f_queue_native_leg(1, f, stopDistNative)
            for f = 0 to FAMS - 1
                if array.get(nLegsCreated, 0) < LEGS and array.get(barAnyLong, f) and not array.get(usedFamNative, f)
                    f_queue_native_leg(1, f, stopDistNative)

    if survShortCountN > 0 and survLongCountN == 0
        campaignStartedToday := true
        campaignDir := -1
        campaignStartTime := time
        if variantCode == 0
            bool done = false
            for f = 0 to FAMS - 1
                if not done and array.get(barSurvShort, f)
                    f_queue_native_leg(-1, f, stopDistNative)
                    done := true
        if variantCode == 1
            for f = 0 to FAMS - 1
                if array.get(nLegsCreated, 0) < LEGS and array.get(barSurvShort, f)
                    f_queue_native_leg(-1, f, stopDistNative)
        if variantCode == 2
            for f = 0 to FAMS - 1
                if array.get(nLegsCreated, 0) < LEGS and array.get(barSurvShort, f)
                    f_queue_native_leg(-1, f, stopDistNative)
            for f = 0 to FAMS - 1
                if array.get(nLegsCreated, 0) < LEGS and array.get(barAnyShort, f) and not array.get(usedFamNative, f)
                    f_queue_native_leg(-1, f, stopDistNative)

// Start V3 consensus.
if ready and stopTicksNative > 0 and not campaignStartedToday and variantCode == 3
    int longAny30N = 0
    int shortAny30N = 0
    int longSurv30N = 0
    int shortSurv30N = 0
    for f = 0 to FAMS - 1
        int la = array.get(lastAnyLong, f)
        int sa = array.get(lastAnyShort, f)
        int ls = array.get(lastSurvLong, f)
        int ss = array.get(lastSurvShort, f)
        longAny30N += not na(la) and time - la <= CONFIRM_MS ? 1 : 0
        shortAny30N += not na(sa) and time - sa <= CONFIRM_MS ? 1 : 0
        longSurv30N += not na(ls) and time - ls <= CONFIRM_MS ? 1 : 0
        shortSurv30N += not na(ss) and time - ss <= CONFIRM_MS ? 1 : 0
    bool lc = longAny30N >= 2 and longSurv30N >= 1
    bool sc = shortAny30N >= 2 and shortSurv30N >= 1
    if lc and not sc
        campaignStartedToday := true
        campaignDir := 1
        campaignStartTime := time
        for f = 0 to FAMS - 1
            int la = array.get(lastAnyLong, f)
            if not na(la) and time - la <= CONFIRM_MS
                array.set(usedFamNative, f, true)
        f_queue_native_leg(1, -1, stopDistNative)
    if sc and not lc
        campaignStartedToday := true
        campaignDir := -1
        campaignStartTime := time
        for f = 0 to FAMS - 1
            int sa = array.get(lastAnyShort, f)
            if not na(sa) and time - sa <= CONFIRM_MS
                array.set(usedFamNative, f, true)
        f_queue_native_leg(-1, -1, stopDistNative)

// Later add-ons require an actually open same-direction position.
bool positionAlive = (campaignDir == 1 and strategy.position_size > 0) or (campaignDir == -1 and strategy.position_size < 0)
if campaignStartedToday and variantCode >= 1 and array.get(nLegsCreated, 0) < LEGS and positionAlive and time - campaignStartTime <= CONFIRM_MS
    for f = 0 to FAMS - 1
        bool anyEvent = campaignDir == 1 ? array.get(barAnyLong, f) : array.get(barAnyShort, f)
        bool survEvent = campaignDir == 1 ? array.get(barSurvLong, f) : array.get(barSurvShort, f)
        bool classOK = variantCode == 1 ? survEvent : anyEvent
        if classOK and not array.get(usedFamNative, f) and array.get(nLegsCreated, 0) < LEGS
            f_queue_native_leg(campaignDir, f, stopDistNative)

// Submit queued market entries. Each fixed ID corresponds to one leg.
for l = 0 to LEGS - 1
    int d = array.get(placeDir, l)
    if d != 0
        int fam = array.get(placeFam, l)
        string lid = "T20L" + str.tostring(l + 1)
        string ftxt = fam >= 0 ? str.tostring(fam) : "CONSENSUS"
        string cmt = "TEST20|" + target + "|" + variant + "|L" + str.tostring(l + 1) + (d == 1 ? "|LONG|" : "|SHORT|") + "FAM=" + ftxt
        strategy.entry(lid, d == 1 ? strategy.long : strategy.short, comment=cmt)
        latestOrderBar := bar_index

// Find each open trade and maintain its own stop / 120m clock.
if strategy.opentrades > 0
    for tradeNum = 0 to strategy.opentrades - 1
        string oid = strategy.opentrades.entry_id(tradeNum)
        float ep = strategy.opentrades.entry_price(tradeNum)
        int et = strategy.opentrades.entry_time(tradeNum)
        for l = 0 to LEGS - 1
            string lid = "T20L" + str.tostring(l + 1)
            if oid == lid
                float sd = array.get(legStopNative, l)
                int d = array.get(legDirNative, l)
                if not na(sd)
                    strategy.exit("T20S" + str.tostring(l + 1), from_entry=lid, stop=d == 1 ? ep - sd : ep + sd, comment="TEST20|STOP|L" + str.tostring(l + 1))
                if time_close >= et + 120 * 60 * 1000
                    strategy.close(lid, comment="TEST20|MAXHOLD|L" + str.tostring(l + 1), immediately=true)

// No opposite-signal exit/reversal in TEST20 V1.
if flattenNow
    strategy.close_all(comment="TEST20|1545_FLAT", immediately=true)
if session.islastbar and strategy.position_size != 0
    strategy.close_all(comment="TEST20|SESSION_LAST", immediately=true)

plot(vwap, "RTH VWAP")
plot(wvwap, "WTD VWAP")
plot(mvwap, "MTD VWAP")

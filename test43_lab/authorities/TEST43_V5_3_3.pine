// Continuation lane:
// - no failed high breakout,
// - current bar not bearish,
// - structure is still continuation-active.
//
// Reversal lane:
// - still has >=2/3 reversal evidence,
// - and current bar shows recovery / rejection.
//
// This is deliberately NOT a blind timer BUY.
//====================================================
int barsWithoutFillForSignal = (not na( lastFillBar ) ? bar_index - lastFillBar : 1000000)
bool antiStallContinuationOK = (continuationMode and not anyFailedHighBreak and close >= open)
bool antiStallReversalOK = (reversalMode and reversalEvidenceCount >= 2 and ( bottomRejection or anyFailedLowBreak or close > close[1] ))
bool antiStallBaseSignal = (inventoryLive and buyWindow and posNow < baseGoal and posNow + lotQty <= baseGoal and posNow + lotQty <= activeTargetQty and barsWithoutFillForSignal >= antiStallBars and addCooldownOK and ( antiStallContinuationOK or antiStallReversalOK ))
//====================================================
// BASE BUILD
//====================================================
bool driftPullbackPermission = (( not controlledUpsideBias ) or ( controlledDriftDip or vwapZ <= -0.50 or pos60 <= bottomRangePct or posCurrentRTH <= bottomRangePct ))
bool baseBuildSignal = (( inventoryLive and buyWindow and posNow < baseGoal and posNow + lotQty <= baseGoal and posNow + lotQty <= activeTargetQty and addCooldownOK ) and ( ( easyPullback and driftPullbackPermission ) or targetRaisedThisBar or strengthEvent or continuationCatchupHold or antiStallBaseSignal or controlledDriftBuySignal ))
//====================================================
// OVERLAY BUY
//====================================================
bool overlayBuySignal = (( inventoryLive and buyWindow and posNow >= baseGoal and posNow < activeTargetQty and posNow + lotQty <= activeTargetQty and addCooldownOK ) and ( ( easyPullback and driftPullbackPermission ) or strengthEvent or controlledDriftBuySignal ))
//====================================================
// PROFIT / REPAIR SELL SIGNALS
//====================================================
float overlayProfitMove = (math.max( atr * recycleTPATR, syminfo.mintick * recycleMinTicks ))
float baseRotationMove = (math.max( atr * baseRotateATR, syminfo.mintick * baseRotateMinTicks ))
bool overlayProfitSell = (inventoryLive and inRTH and posNow > baseGoal and not na( lastBuyFillPrice ) and ( close >= lastBuyFillPrice + overlayProfitMove or ( rsi2 >= fastSellRSI and close > lastBuyFillPrice ) ))
bool baseProfitRotationSell = (( inventoryLive and inRTH and posNow >= 4 and posNow <= baseGoal ) and ( not protectCoreBase ) and ( close >= strategy.position_avg_price + baseRotationMove ) and ( rsi2 >= baseSellRSI or anyFailedHighBreak ))
float recentLow = (ta.lowest( low, repairLookback ))
float overlayRepairMove = (math.max( atr * overlayRepairSellATR, syminfo.mintick * overlayRepairSellTicks ))
float baseRepairMove = (math.max( atr * baseRepairSellATR, syminfo.mintick * baseRepairSellTicks ))
float requiredRepairMove = (posNow <= baseGoal ? baseRepairMove : overlayRepairMove)
bool meaningfulRepairRebound = (inRTH and close - recentLow >= requiredRepairMove)
bool reboundEvidence = (inRTH and ( rsi2 > rsi2[1] or wr2 > wr2[1] or close > open or close > high[1] ))
bool underwater = (inventoryLive and strategy.openprofit < 0)
bool coreRotationEligible = (allowCoreRotation and not protectCoreBase and posNow == lotQty and inventoryAge >= coreRotationAgeBars and strategy.openprofit <= -coreRotationMinLoss)
bool repairSlotAvailable = (( not useOneRepairSlot ) or ( not repairPending ))
bool repairBaseFloorOK = (( not protectCoreBase ) or ( posNow - lotQty >= baseGoal ))
bool repairLocationRecovered = (( not useRepairLocationGate ) or ( vwapZ >= repairMinVWAPZ and pos60 >= repairMin60Pos and posCurrentRTH >= repairMinSessionPos ))
bool underwaterSellSignal = (( inventoryLive and inRTH and underwater and meaningfulRepairRebound and reboundEvidence ) and ( repairSlotAvailable and repairBaseFloorOK and repairLocationRecovered ) and ( posNow > lotQty or coreRotationEligible ))
bool failedHighSellSignal = (( inventoryLive and inRTH and anyFailedHighBreak and posNow > lotQty ) and ( repairSlotAvailable and repairBaseFloorOK and repairLocationRecovered ) and ( close < open or rsi2 >= fastSellRSI or high - close >= candleRange * 0.35 ))
bool excessTargetSellSignal = (inventoryLive and inRTH and posNow > activeTargetQty and reboundEvidence)
bool coreProfitExit = (( inventoryLive and inRTH and posNow == lotQty and activeTargetQty <= 2 and not protectCoreBase ) and ( not na( coreATR ) and close >= strategy.position_avg_price + coreATR * coreTPATR ))
//====================================================
// V5.3 FAILED-REPAIR RESTORE
//
// A repair slot can finish only by:
// 1) lower successful REBUY, or
// 2) higher/timeout/late-session restoration.
// No silent cancellation that leaves long exposure permanently missing.
//====================================================
float failedRepairRestoreMove = (math.max( atr * failedRepairRestoreATR, syminfo.mintick * failedRepairRestoreTicks ))
bool strengthInvalidatesRepair = (( repairPending and inRTH and not na( repairSellReference ) and strengthEvent ) and ( close >= repairSellReference + atr * abandonRepairStrengthATR ))
bool repairPriceFailedHigher = (( repairPending and inRTH and not na( repairSellReference ) ) and ( close >= repairSellReference + failedRepairRestoreMove ))
bool repairTimedOut = (repairPending and repairAge >= repairLifeBars)
bool repairLateSessionRestore = (( repairPending and inRTH and hh == 15 ) and ( mm >= 48 ))
bool failedRepairRestoreSignal = (( inventoryLive and inRTH and repairPending and posNow < repairRestoreCap and posNow + lotQty <= repairRestoreCap and posNow + lotQty <= intradayMaxQty ) and ( repairPriceFailedHigher or strengthInvalidatesRepair or repairTimedOut or repairLateSessionRestore ))
//====================================================
// COST-AWARE OPPOSITE-SIDE CHURN CONTROL
//
// Normal BUY/SELL reversals require:
// - a minimum number of bars since the opposite fill,
// - and a minimum price displacement.
//
// Structural risk sells remain allowed immediately.
//====================================================




bool sellAfterBuyBarsOK = (na( lastBuyFillBar ) or bar_index - lastBuyFillBar >= oppositeSideCooldownBars)
bool buyAfterSellBarsOK = (na( lastSellFillBar ) or bar_index - lastSellFillBar >= oppositeSideCooldownBars)
float oppositeMoveFloor = (math.max( atr * minimumOppositeMoveATR, syminfo.mintick * 4 ))
bool sellAfterBuyPriceOK = (lastFilledSide != "BUY" or na( lastInventoryFillPrice ) or close >= lastInventoryFillPrice + oppositeMoveFloor)
bool buyAfterSellPriceOK = (lastFilledSide != "SELL" or na( lastInventoryFillPrice ) or close <= lastInventoryFillPrice - oppositeMoveFloor or freshStructuralEvidence)
bool normalSellChurnOK = (sellAfterBuyBarsOK and sellAfterBuyPriceOK)
bool normalBuyChurnOK = (buyAfterSellBarsOK and buyAfterSellPriceOK)
//====================================================
// ONE INVENTORY ACTION PER BAR
//
// Priority:
// 1) TARGET / STRUCTURAL SELL
// 2) PAIRED LOWER REPAIR BUY
// 3) FAILED / TIMEOUT REPAIR RESTORE BUY
// 4) BASE BUILD BUY
// 5) OVERLAY PROFIT SELL
// 6) BASE PROFIT ROTATION SELL (disabled when core protected)
// 7) OVERLAY BUY
//====================================================
if (inventoryLive and inRTH and not buyOrderSubmitted and not sellOrderSubmitted)
    if (excessTargetSellSignal)
        sellOrderSubmitted := (true)
        sellOrderQty := (math.min( lotQty, int( posNow ) ))
        sellOrderReason := ("TARGET_TRIM")
        riskSellCount += (1)
    else if (failedHighSellSignal)
        sellOrderSubmitted := (true)
        sellOrderQty := (math.min( lotQty, int( posNow ) ))
        sellOrderReason := ("REPAIR_SELL")
        repairRestoreCap := (int( posNow ))
        riskSellCount += (1)
    else if (underwaterSellSignal)
        sellOrderSubmitted := (true)
        sellOrderQty := (math.min( lotQty, int( posNow ) ))
        sellOrderReason := ("REPAIR_SELL")
        repairRestoreCap := (int( posNow ))
        riskSellCount += (1)
    else if (repairAddSignal)
        buyOrderSubmitted := (true)
        buyOrderQty := (lotQty)
        buyOrderReason := ("LOWER_REBUY")
        repairBuyCount += (1)
    else if (failedRepairRestoreSignal)
        buyOrderSubmitted := (true)
        buyOrderQty := (lotQty)
        buyOrderReason := ("FAILED_RESTORE")
        repairBuyCount += (1)
    else if (baseBuildSignal and normalBuyChurnOK)
        buyOrderSubmitted := (true)
        buyOrderQty := (lotQty)
        if (antiStallBaseSignal)
            buyOrderReason := ("BASE_ANTISTALL")
            antiStallBuyCount += (1)
        else if (continuationCatchupHold or strengthEvent)
            buyOrderReason := ("BASE_STRENGTH")
            strengthBuyCount += (1)
        else if (controlledDriftBuySignal)
            buyOrderReason := ("DRIFT_BASE")
            pullbackBuyCount += (1)
        else
            buyOrderReason := ("BASE_PULLBACK")
            pullbackBuyCount += (1)
        baseBuildCount += (1)
    else if (overlayProfitSell and normalSellChurnOK)
        sellOrderSubmitted := (true)
        sellOrderQty := (lotQty)
        sellOrderReason := ("PROFIT_SELL")
        profitSellCount += (1)
    else if (baseProfitRotationSell and normalSellChurnOK)
        sellOrderSubmitted := (true)
        sellOrderQty := (lotQty)
        sellOrderReason := ("BASE_ROTATE")
        profitSellCount += (1)
    else if (coreProfitExit and normalSellChurnOK)
        sellOrderSubmitted := (true)
        sellOrderQty := (lotQty)
        sellOrderReason := ("CORE_EXIT")
        profitSellCount += (1)
    else if (overlayBuySignal and normalBuyChurnOK)
        buyOrderSubmitted := (true)
        buyOrderQty := (lotQty)
        if (strengthEvent)
            buyOrderReason := ("OVERLAY_STRENGTH")
            strengthBuyCount += (1)
        else if (controlledDriftBuySignal)
            buyOrderReason := ("DRIFT_OVERLAY")
            pullbackBuyCount += (1)
        else
            buyOrderReason := ("OVERLAY_PULLBACK")
            pullbackBuyCount += (1)
        overlayBuyCount += (1)
//====================================================
// 16:12 OPTIONAL OVERNIGHT TRIM
//
// V5.3.3 default = OFF. With trim disabled, the strategy carries
// the full existing long inventory overnight, subject only to the
// intraday hard cap and broker margin model.
//====================================================
if (enableOvernightTrim and trimDecisionBar and posNow > overnightMaxQty and not sellOrderSubmitted and not buyOrderSubmitted)
    sellOrderSubmitted := (true)
    sellOrderQty := (posNow - overnightMaxQty)
    sellOrderReason := ("OVERNIGHT_TRIM")
    overnightTrimCount += (1)
//====================================================
// OPTIONAL EMERGENCY
//====================================================
if (emergencyEnabled and posNow > 0 and strategy.openprofit <= -emergencyLossDollar)
    strategy.close_all(
         immediately = true,
         comment =
             "EMERGENCY_KILL"
    )
//====================================================
// SUBMIT NET BUY ORDER
//
// strategy.order() ignores pyramiding.
//====================================================
if (buyOrderSubmitted and buyOrderQty > 0)
    float remainingLongCapacity = (math.max( intradayMaxQty - posNow, 0 ))
    float safeBuyQty = (math.min( buyOrderQty, remainingLongCapacity ))
    if (safeBuyQty > 0)
        strategy.order(
             "INV_BUY",
             strategy.long,
             qty =
                 safeBuyQty,
             comment =
                 buyOrderReason
        )
        buyOrderCount += (1)
        lastBuyOrderBar := (bar_index)
        lastInventoryActionBar := (bar_index)
        pendingOrderSide := ("BUY")
        pendingOrderReason := (buyOrderReason)
        pendingOrderQty := (safeBuyQty)
        pendingOrderBar := (bar_index)
//====================================================
// SUBMIT NET SELL ORDER
//
// A short strategy.order() while long reduces
// the net long position. Quantity is always <= position.
//====================================================
if (sellOrderSubmitted and sellOrderQty > 0 and posNow > 0)
    float safeSellQty = (math.min( sellOrderQty, posNow ))
    strategy.order(
         "INV_SELL",
         strategy.short,
         qty =
             safeSellQty,
         comment =
             sellOrderReason
    )
    sellOrderCount += (1)
    lastSellOrderBar := (bar_index)
    lastInventoryActionBar := (bar_index)
    pendingOrderSide := ("SELL")
    pendingOrderReason := (sellOrderReason)
    pendingOrderQty := (safeSellQty)
    pendingOrderBar := (bar_index)
//====================================================
// CUSTOM ORDER-CREATED MARKERS
//====================================================
plotshape(
     (showOrderMarkers and buyOrderSubmitted),
     title =
         "BUY ORDER CREATED",
     style =
         shape.circle,
     location =
         location.belowbar,
     text =
         "B?",
     size =
         size.tiny,
     color =
         color.aqua,
     textcolor =
         color.black
)
plotshape(
     (showOrderMarkers and sellOrderSubmitted),
     title =
         "SELL ORDER CREATED",
     style =
         shape.circle,
     location =
         location.abovebar,
     text =
         "S?",
     size =
         size.tiny,
     color =
         color.orange,
     textcolor =
         color.black
)
//====================================================
// CUSTOM ACTUAL-FILL MARKERS
//
// Native TradingView strategy execution arrows should
// ALSO appear when Chart Settings > Trading > Executions
// is enabled.
//====================================================
plotshape(
     (showTradeMarkers and actualBuy),
     title =
         "ACTUAL BUY FILL",
     style =
         shape.labelup,
     location =
         location.belowbar,
     text =
         "BUY",
     size =
         size.normal,
     color =
         color.lime,
     textcolor =
         color.black
)
plotshape(
     (showTradeMarkers and actualSell),
     title =
         "ACTUAL SELL FILL",
     style =
         shape.labeldown,
     location =
         location.abovebar,
     text =
         "SELL",
     size =
         size.normal,
     color =
         color.red,
     textcolor =
         color.white
)
//====================================================
// PUSH CURRENT RTH BAR INTO ROLLING ARRAYS
//
// AFTER signal calculations.
//====================================================
if (inRTH)
    array.push(
         rthHighs,
         high
    )
    array.push(
         rthLows,
         low
    )
    if (array.size( rthHighs ) > 20)
        array.shift(
             rthHighs
        )
        array.shift(
             rthLows
        )
//====================================================
// DAILY MARK-TO-MARKET P&L
//====================================================
var float dayStartEquity = (na)
var float dayStartNetProfit = (na)
var int dayStartClosedTrades = (0)
var float dayStartBoughtContracts = (0.0)
var float dayStartSoldContracts = (0.0)
var float cumulativeDayPnL = (0.0)
var int completedDays = (0)
var int positiveDays = (0)
var int targetDays = (0)
var float bestDay = (na)
var float worstDay = (na)
if (newRTH)
    if (not na( dayStartEquity ))
        float finishedDay = (strategy.equity - dayStartEquity)
        completedDays += (1)
        cumulativeDayPnL += (finishedDay)
        if (finishedDay > 0)
            positiveDays += (1)
        if (finishedDay >= dailyTarget)
            targetDays += (1)
        bestDay := (na( bestDay ) ? finishedDay : math.max( bestDay, finishedDay ))
        worstDay := (na( worstDay ) ? finishedDay : math.min( worstDay, finishedDay ))
    dayStartEquity := (strategy.equity)
    dayStartNetProfit := (strategy.netprofit)
    dayStartClosedTrades := (strategy.closedtrades)
    dayStartBoughtContracts := (boughtContracts)
    dayStartSoldContracts := (soldContracts)
float currentDayPnL = (not na( dayStartEquity ) ? strategy.equity - dayStartEquity : 0)
float avgDailyPnL = (completedDays > 0 ? cumulativeDayPnL / completedDays : na)
float positiveDayPct = (completedDays > 0 ? ( positiveDays / completedDays ) * 100 : na)
float targetHitPct = (completedDays > 0 ? ( targetDays / completedDays ) * 100 : na)
//====================================================
// CURRENT-DAY TURNOVER DIAGNOSTICS
//====================================================
float realizedPnLToday = (not na( dayStartNetProfit ) ? strategy.netprofit - dayStartNetProfit : 0)
int closedTradesToday = (strategy.closedtrades - dayStartClosedTrades)
float contractSidesToday = (( boughtContracts - dayStartBoughtContracts ) + ( soldContracts - dayStartSoldContracts ))
float avgRealizedPerClosedTrade = (closedTradesToday > 0 ? realizedPnLToday / closedTradesToday : na)
float avgRealizedPerFillEvent = (( buyFillEvents + sellFillEvents ) > 0 ? realizedPnLToday / math.max( 1, buyFillEvents + sellFillEvents ) : na)
//====================================================
// PERFORMANCE / MARGIN DIAGNOSTICS
//====================================================
float totalPnL = (strategy.netprofit + strategy.openprofit)
float winRate = (strategy.closedtrades > 0 ? ( strategy.wintrades / strategy.closedtrades ) * 100 : na)
float grossLossAbs = (math.abs( strategy.grossloss ))
float profitFactor = (grossLossAbs > 0 ? strategy.grossprofit / grossLossAbs : na)
float estimatedCommission = (( boughtContracts + soldContracts ) * 0.62)
float estimatedSlippageCost = (( boughtContracts + soldContracts ) * syminfo.mintick * syminfo.pointvalue)
float estimatedTotalFriction = (estimatedCommission + estimatedSlippageCost)
float estimatedGrossBeforeFriction = (totalPnL + estimatedTotalFriction)
float contractNotional = (close * syminfo.pointvalue)
float pineMarginPerContract = (contractNotional * 0.10)
int pineMarginCapacity = (pineMarginPerContract > 0 ? int( math.floor( strategy.equity / pineMarginPerContract ) ) : 0)
int ibkrIntradayCapacity = (ibkrIntradayInitialRef > 0 ? int( math.floor( strategy.equity / ibkrIntradayInitialRef ) ) : 0)
int ibkrOvernightCapacity = (ibkrOvernightInitialRef > 0 ? int( math.floor( strategy.equity / ibkrOvernightInitialRef ) ) : 0)
int displayTarget = (inRTH ? activeTargetQty : int( math.max( posNow, 0 ) ))
int displayBase = (inRTH ? baseGoal : int( math.max( posNow, 0 ) ))
string displayState = (inRTH ? structuralState : "OVERNIGHT HOLD")
string displayLane = (inRTH ? dayLane : "INVENTORY ONLY")
float targetFillPct = (displayTarget > 0 ? ( posNow / displayTarget ) * 100 : 0)
float baseFillPct = (displayBase > 0 ? ( posNow / displayBase ) * 100 : 0)
int barsSinceFill = (not na( lastFillBar ) ? bar_index - lastFillBar : 0)
string repairText = (repairPending ? "PENDING " + str.tostring( repairAge ) + "/" + str.tostring( repairLifeBars ) : "OFF")
//====================================================
// DASHBOARD
//====================================================
var table dash = (table.new( position.top_right, 2, 54, border_width = 1 ))
if (barstate.islast and showDashboard)
    table.cell(dash, 0, 0, "VERSION")
    table.cell(dash, 1, 0, "V5.3.3")
    table.cell(dash, 0, 1, "Execution Model")
    table.cell(dash, 1, 1, "strategy.order / next-open")
    table.cell(dash, 0, 2, "Day Lane")
    table.cell(dash, 1, 2, displayLane)
    table.cell(dash, 0, 3, "State")
    table.cell(dash, 1, 3, displayState)
    table.cell(dash, 0, 4, "Reversal Evidence")
    table.cell(
         dash,
         1,
         4,
         str.tostring(
             reversalEvidenceCount
         ) +
         "/3"
    )
    table.cell(dash, 0, 5, "Range Score")
    table.cell(
         dash,
         1,
         5,
         str.tostring(
             rangeScore
         ) +
         "/5"
    )
    table.cell(dash, 0, 6, "Target / Base")
    table.cell(
         dash,
         1,
         6,
         str.tostring(
             displayTarget
         ) +
         " / " +
         str.tostring(
             displayBase
         )
    )
    table.cell(dash, 0, 7, "Position MES")
    table.cell(
         dash,
         1,
         7,
         str.tostring(
             posNow
         )
    )
    table.cell(dash, 0, 8, "Target / Base Fill")
    table.cell(
         dash,
         1,
         8,
         str.tostring(
             targetFillPct,
             "#.0"
         ) +
         "% / " +
         str.tostring(
             baseFillPct,
             "#.0"
         ) +
         "%"
    )
    table.cell(dash, 0, 9, "Repair")
    table.cell(dash, 1, 9, repairText)
    table.cell(dash, 0, 10, "RSI2 / W%R2")
    table.cell(
         dash,
         1,
         10,
         str.tostring(
             rsi2,
             "#.0"
         ) +
         " / " +
         str.tostring(
             wr2,
             "#.0"
         )
    )
    table.cell(dash, 0, 11, "Bars Since Fill")
    table.cell(
         dash,
         1,
         11,
         str.tostring(
             barsSinceFill
         )
    )
    table.cell(dash, 0, 12, "BUY / SELL Fills")
    table.cell(
         dash,
         1,
         12,
         str.tostring(
             buyFillEvents
         ) +
         " / " +
         str.tostring(
             sellFillEvents
         )
    )
    table.cell(dash, 0, 13, "BUY / SELL Orders")
    table.cell(
         dash,
         1,
         13,
         str.tostring(
             buyOrderCount
         ) +
         " / " +
         str.tostring(
             sellOrderCount
         )
    )
    table.cell(dash, 0, 14, "Unfilled Orders")
    table.cell(
         dash,
         1,
         14,
         str.tostring(
             unfilledOrderCount
         )
    )
    table.cell(dash, 0, 15, "Max MES")
    table.cell(
         dash,
         1,
         15,
         str.tostring(
             maxMESSeen,
             "#"
         )
    )
    table.cell(dash, 0, 16, "TV Margin Capacity")
    table.cell(
         dash,
         1,
         16,
         str.tostring(
             pineMarginCapacity
         ) +
         " MES"
    )
    table.cell(dash, 0, 17, "IBKR Intra/ON Cap")
    table.cell(
         dash,
         1,
         17,
         str.tostring(
             ibkrIntradayCapacity
         ) +
         " / " +
         str.tostring(
             ibkrOvernightCapacity
         )
    )
    table.cell(dash, 0, 18, "Contract Notional")
    table.cell(
         dash,
         1,
         18,
         "$" +
         str.tostring(
             contractNotional,
             "#"
         )
    )
    table.cell(dash, 0, 19, "TV Margin/Contract")
    table.cell(
         dash,
         1,
         19,
         "$" +
         str.tostring(
             pineMarginPerContract,
             "#"
         )
    )
    table.cell(dash, 0, 20, "Base / Overlay Buys")
    table.cell(
         dash,
         1,
         20,
         str.tostring(
             baseBuildCount
         ) +
         " / " +
         str.tostring(
             overlayBuyCount
         )
    )
    table.cell(dash, 0, 21, "Repair Buy / Sell")
    table.cell(
         dash,
         1,
         21,
         str.tostring(
             repairBuyCount
         ) +
         " / " +
         str.tostring(
             repairSellCount
         )
    )
    table.cell(dash, 0, 22, "Profit / Risk Sells")
    table.cell(
         dash,
         1,
         22,
         str.tostring(
             profitSellCount
         ) +
         " / " +
         str.tostring(
             riskSellCount
         )
    )
    table.cell(dash, 0, 23, "Rev / Trend Starts")
    table.cell(
         dash,
         1,
         23,
         str.tostring(
             reversalInitialCount
         ) +
         " / " +
         str.tostring(
             continuationInitialCount
         )
    )
    table.cell(dash, 0, 24, "Open P&L")
    table.cell(
         dash,
         1,
         24,
         "$" +
         str.tostring(
             strategy.openprofit,
             "#"
         )
    )
    table.cell(dash, 0, 25, "Total P&L")
    table.cell(
         dash,
         1,
         25,
         "$" +
         str.tostring(
             totalPnL,
             "#"
         )
    )
    table.cell(dash, 0, 26, "Avg Daily P&L")
    table.cell(
         dash,
         1,
         26,
         na(
             avgDailyPnL
         )
         ? "-"
         : "$" +
           str.tostring(
               avgDailyPnL,
               "#"
           )
    )
    table.cell(dash, 0, 27, "Positive Days")
    table.cell(
         dash,
         1,
         27,
         na(
             positiveDayPct
         )
         ? "-"
         : str.tostring(
               positiveDayPct,
               "#.0"
           ) +
           "%"
    )
    table.cell(dash, 0, 28, "Days >= $600")
    table.cell(
         dash,
         1,
         28,
         str.tostring(
             targetDays
         ) +
         " / " +
         str.tostring(
             completedDays
         )
    )
    table.cell(dash, 0, 29, "Best / Worst Day")
    table.cell(
         dash,
         1,
         29,
         na(
             bestDay
         )
         ? "-"
         : "$" +
           str.tostring(
               bestDay,
               "#"
           ) +
           " / $" +
           str.tostring(
               worstDay,
               "#"
           )
    )
    table.cell(dash, 0, 30, "Max Drawdown")
    table.cell(
         dash,
         1,
         30,
         "$" +
         str.tostring(
             strategy.max_drawdown,
             "#"
         )
    )
    table.cell(dash, 0, 31, "Worst Open P&L")
    table.cell(
         dash,
         1,
         31,
         "$" +
         str.tostring(
             worstOpenPnL,
             "#"
         )
    )
    table.cell(dash, 0, 32, "Win Rate / PF")
    table.cell(
         dash,
         1,
         32,
         (
             na(
                 winRate
             )
             ? "-"
             : str.tostring(
                   winRate,
                   "#.0"
               ) +
               "%"
         ) +
         " / " +
         (
             na(
                 profitFactor
             )
             ? "-"
             : str.tostring(
                   profitFactor,
                   "#.00"
               )
         )
    )
    table.cell(dash, 0, 33, "Cost Model")
    table.cell(
         dash,
         1,
         33,
         "$0.62/side + 1t"
    )
    table.cell(dash, 0, 34, "MTM P&L Today")
    table.cell(
         dash,
         1,
         34,
         "$" +
         str.tostring(
             currentDayPnL,
             "#"
         )
    )
    table.cell(dash, 0, 35, "Realized P&L Today")
    table.cell(
         dash,
         1,
         35,
         "$" +
         str.tostring(
             realizedPnLToday,
             "#"
         )
    )
    table.cell(dash, 0, 36, "Closed Trades Today")
    table.cell(
         dash,
         1,
         36,
         str.tostring(
             closedTradesToday
         )
    )
    table.cell(dash, 0, 37, "Contract Sides Today")
    table.cell(
         dash,
         1,
         37,
         str.tostring(
             contractSidesToday,
             "#"
         )
    )
    table.cell(dash, 0, 38, "Avg Realized/Closed")
    table.cell(
         dash,
         1,
         38,
         na(
             avgRealizedPerClosedTrade
         )
         ? "-"
         : "$" +
           str.tostring(
               avgRealizedPerClosedTrade,
               "#.0"
           )
    )
    table.cell(dash, 0, 39, "Anti-Stall Buys")
    table.cell(
         dash,
         1,
         39,
         str.tostring(
             antiStallBuyCount
         )
    )
    table.cell(dash, 0, 40, "Strength / Pullback Buys")
    table.cell(
         dash,
         1,
         40,
         str.tostring(
             strengthBuyCount
         ) +
         " / " +
         str.tostring(
             pullbackBuyCount
         )
    )
    table.cell(dash, 0, 41, "Daily Goal")
    table.cell(
         dash,
         1,
         41,
         "$600 avg target"
    )




    table.cell(dash, 0, 42, "Est Commission")
    table.cell(
         dash,
         1,
         42,
         "$" +
         str.tostring(
             estimatedCommission,
             "#"
         )
    )




    table.cell(dash, 0, 43, "Est Slippage")
    table.cell(
         dash,
         1,
         43,
         "$" +
         str.tostring(
             estimatedSlippageCost,
             "#"
         )
    )




    table.cell(dash, 0, 44, "Est Total Friction")
    table.cell(
         dash,
         1,
         44,
         "$" +
         str.tostring(
             estimatedTotalFriction,
             "#"
         )
    )




    table.cell(dash, 0, 45, "Est Gross Before Cost")
    table.cell(
         dash,
         1,
         45,
         "$" +
         str.tostring(
             estimatedGrossBeforeFriction,
             "#"
         )
    )
    table.cell(dash, 0, 46, "RTH VWAP Z")
    table.cell(
         dash,
         1,
         46,
         str.tostring(
             vwapZ,
             "#.00"
         )
    )
    table.cell(dash, 0, 47, "60m / Session RP")
    table.cell(
         dash,
         1,
         47,
         str.tostring(
             pos60 *
             100,
             "#.0"
         ) +
         "% / " +
         str.tostring(
             posCurrentRTH *
             100,
             "#.0"
         ) +
         "%"
    )
    table.cell(dash, 0, 48, "5D RTH RP")
    table.cell(
         dash,
         1,
         48,
         str.tostring(
             pos5D *
             100,
             "#.0"
         ) +
         "%"
    )
    table.cell(dash, 0, 49, "Drift Location Score")
    table.cell(
         dash,
         1,
         49,
         str.tostring(
             driftLocationScore
         ) +
         "/4"
    )
    table.cell(dash, 0, 50, "VWAP Deep Reclaim")
    table.cell(
         dash,
         1,
         50,
         vwapDeepReclaim
         ? "YES"
         : "NO"
    )
    table.cell(dash, 0, 51, "Repair Success / Restore")
    table.cell(
         dash,
         1,
         51,
         str.tostring(
             repairSuccessFillCount
         ) +
         " / " +
         str.tostring(
             repairFailedRestoreFillCount
         )
    )
    table.cell(dash, 0, 52, "Repair SELL Gate")
    table.cell(
         dash,
         1,
         52,
         (repairSlotAvailable and repairBaseFloorOK and repairLocationRecovered)
         ? "OPEN"
         : "BLOCKED"
    )
    table.cell(dash, 0, 53, "Drift Bias Buys")
    table.cell(
         dash,
         1,
         53,
         str.tostring(
             controlledDriftBuyCount
         )
    )
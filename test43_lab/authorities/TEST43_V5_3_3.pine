//@version=6
strategy(
     "TEST43 V5.3.3 — MES 3m Step-1 Full-Overnight — Parser Safe",
     overlay = true,
     behind_chart = false,
     // Account model.
     initial_capital = 150000,
     currency = currency.USD,
     // Intentionally irrelevant to the inventory engine:
     // all inventory changes use strategy.order(), which ignores pyramiding.
     pyramiding = 1,
     // Costs.
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.62,
     slippage = 1,
     // IMPORTANT:
     // TradingView defaults to 100% margin (1:1), which blocks
     // realistic futures pyramiding. 10% is intentionally conservative
     // versus the current IBKR MES overnight initial margin near 9.2%
     // of notional at ~7800.
     margin_long = 10,
     margin_short = 10,
     // Deterministic once-per-bar-close research model.
     // Market orders fill on the next available tick / next bar open.
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     process_orders_on_close = false
)
//====================================================
// TEST43 V5.3.3
//
// WHY THIS REWRITE EXISTS
//
// 1) Pine strategies calculate once per bar close by default.
// 2) Market orders created at bar close fill on the next tick,
//    normally the next bar open.
// 3) strategy.entry() is limited by the Properties > Pyramiding value.
// 4) strategy.order() ignores pyramiding and nets directly against
//    the current position.
// 5) TradingView defaults to margin_long = 100% (1:1).
//    For MES this can cap a $150k simulation around 4 contracts.
// 6) This version therefore:
//      - uses strategy.order() for ALL inventory changes,
//      - sets margin_long = 10%,
//      - uses one net position instead of C2...C12 entry IDs,
//      - tracks order attempts vs actual fills.
//
//====================================================
// V5.3 CONTROLLED-DRIFT / PAIRED-REPAIR RESEARCH BUILD
//
// Intentional structural prior:
// - U.S. index upside drift is treated as a long-side prior.
// - Base Goal can be protected as core inventory.
// - Deep multi-timeframe weakness + reclaim can receive more size.
// - Repair SELL is forbidden while another repair slot is pending.
// - Repair SELL is blocked near lower VWAP/range locations.
// - Every repair slot must restore lower (success) or higher/timeout
//   (failed repair); no silent cancellation.
//
// Controlled overfit boundary:
// - broad 0.25 range buckets and 1.0/1.5/2.0 sigma concepts,
// - no date-specific exceptions,
// - no single historical regime special case,
// - execution layer unchanged.
//====================================================
//====================================================
// V5.2 COST-AWARE RECYCLING
//
// V5.1 proved that the execution layer can use the full 24-MES cap,
// but it also overtraded badly. V5.2 keeps the execution layer frozen
// and changes only the strategy economics.
//
// Main changes:
// - overlay recycle minimum profit raised to 12 ticks,
// - lower-rebuy gap raised to 10 ticks,
// - stronger underwater/base repair rebound requirements,
// - opposite-side cooldown + minimum price displacement,
// - failed-high SELL requires extra confirmation,
// - anti-stall slowed from 30m to 45m,
// - repair SELL counter reporting fixed,
// - estimated commission/slippage/gross-before-friction added.
//
// Goal:
// fewer cycles, larger captured move per cycle, lower friction drag.
//
//====================================================
//====================================================
// V5.2 STRATEGY-LAYER ADDITIONS
//
// EXECUTION LAYER IS FROZEN FROM THE PASSED HARNESS:
// - strategy.order()
// - margin_long / margin_short = 10
// - next-open market fill model
// - one inventory action per bar
// - absolute 24 MES cap
//
// V5.2 adds ONLY strategy behavior:
// - reversal + continuation dual lane,
// - Base Goal accumulation,
// - recycle overlay,
// - underwater rotation,
// - anti-stall base catch-up,
// - realized vs MTM daily diagnostics.
//
//====================================================
// LONG ONLY INVENTORY CONCEPT
//
// REVERSAL LANE:
//   support/range bottom + exhaustion + reversal.
//
// CONTINUATION LANE:
//   prior-RTH high / opening range / RTH 15/30/60 breakout,
//   follow-through / higher-low / breakout pullback.
//
// OVERNIGHT:
//   inventory may remain,
//   signal engine is frozen.
//
// EACH NEW RTH:
//   keep existing inventory,
//   reset target to current position,
//   rebuild today's structural permission from fresh RTH evidence.
//
// INVENTORY:
//
//   Active Target = max structurally permitted MES.
//   Base Goal     = inventory bias.
//
//   Position < Base Goal:
//       aggressive BUY bias.
//
//   Position ~= Base Goal:
//       balanced recycle.
//
//   Position > Base Goal:
//       SELL / recycle bias.
//
// REPAIR:
//
//   Underwater rebound or failed high breakout can SELL 2.
//   A lower-rebuy opportunity is remembered,
//   but NEVER blocks normal trading.
//
// Intraday max: 24 MES.
// Overnight max: 10 MES.
// RTH trade decisions only, except 16:12 overnight trim.
//
// NO NORMAL HARD STOP.
// Optional catastrophic emergency only.
//====================================================
//====================================================
// POSITION LIMITS
//====================================================
int lotQty = (input.int( 1, "Inventory step MES", minval = 1, maxval = 4 ))
int intradayMaxQty = (input.int( 24, "Intraday max MES", minval = 2, maxval = 40 ))
bool enableOvernightTrim = (input.bool( false, "Enable overnight inventory trim" ))
int overnightMaxQty = (input.int( 24, "Overnight max MES when trim enabled", minval = 1, maxval = 40 ))
//====================================================
// IBKR REFERENCE MARGINS
//
// Informational dashboard only.
// Values can change.
//====================================================
float ibkrIntradayInitialRef = (input.float( 2502.61, "IBKR MES intraday initial margin ref $", minval = 1 ))
float ibkrOvernightInitialRef = (input.float( 3575.15, "IBKR MES overnight initial margin ref $", minval = 1 ))
//====================================================
// SESSION
//====================================================
string rthSession = (input.session( "0930-1600", "RTH Session ET" ))
float dailyTarget = (input.float( 600, "Daily target $", minval = 50 ))
//====================================================
// FAST OSCILLATORS
//====================================================
float rsiExtremeLevel = (input.float( 15, "RSI(2) extreme", minval = 1, maxval = 40 ))
float easyAddRSI = (input.float( 40, "Easy BUY RSI(2)", minval = 10, maxval = 70 ))
float fastSellRSI = (input.float( 65, "Fast recycle SELL RSI(2)", minval = 50, maxval = 99 ))
float baseSellRSI = (input.float( 78, "Base rotation SELL RSI(2)", minval = 60, maxval = 99 ))
float wrExtremeLevel = (input.float( -90, "Williams %R(2) extreme", minval = -100, maxval = -50 ))
float easyAddWR = (input.float( -80, "Easy BUY Williams %R", minval = -100, maxval = -20 ))
//====================================================
// EXHAUSTION
//====================================================
int pushesToExhaustion = (input.int( 3, "Down pushes", minval = 1, maxval = 6 ))
float pushSpacingATR = (input.float( 0.05, "Down-push spacing ATR", minval = 0, step = 0.01 ))
//====================================================
// REVERSAL LOCATION
//====================================================
float bottomRangePct = (input.float( 0.35, "Bottom range zone", minval = 0.10, maxval = 0.70, step = 0.05 ))
int microDBLookback = (input.int( 10, "Micro double-bottom lookback", minval = 3 ))
float microDBToleranceATR = (input.float( 0.20, "Micro DB tolerance ATR", minval = 0.05, step = 0.05 ))
//====================================================
// CONTINUATION
//====================================================
float strongBullBodyPct = (input.float( 0.60, "Strong bull body fraction", minval = 0.40, maxval = 0.90, step = 0.05 ))
float strongBullClosePct = (input.float( 0.75, "Strong bull close position", minval = 0.50, maxval = 1.00, step = 0.05 ))
float strongBullRangeATR = (input.float( 0.80, "Strong bull range / ATR", minval = 0.20, step = 0.05 ))
float higherLowATR = (input.float( 0.05, "Higher-low separation ATR", minval = 0, step = 0.05 ))
float breakoutToleranceATR = (input.float( 0.20, "Breakout pullback tolerance ATR", minval = 0.05, step = 0.05 ))
float continuationATR = (input.float( 0.20, "Continuation distance ATR", minval = 0, step = 0.05 ))
float breakoutClosePct = (input.float( 0.60, "Minimum breakout close position", minval = 0.50, maxval = 0.95, step = 0.05 ))
//====================================================
// BASE BUILD
//====================================================
int strengthBuildBars = (input.int( 6, "Strength catch-up bars", minval = 1, tooltip = "6 x 3m = 18 minutes" ))
float maxCatchupExtensionATR = (input.float( 1.00, "Max continuation catch-up extension ATR", minval = 0.10, step = 0.10 ))
int addCooldownBars = (input.int( 0, "Bars between inventory BUYs", minval = 0, maxval = 10 ))
int oppositeSideCooldownBars = (input.int( 2, "Bars before reversing inventory action", minval = 0, maxval = 10, tooltip = "2 x 3m = 6 minutes. Prevent immediate BUY→SELL→BUY churn." ))
float minimumOppositeMoveATR = (input.float( 0.08, "Minimum price move before opposite action ATR", minval = 0.02, step = 0.02 ))
int antiStallBars = (input.int( 15, "Anti-stall bars without fill", minval = 5, maxval = 40, tooltip = "15 x 3m = 45 minutes. If Position is below Base Goal and structure is still valid, allow a +2 catch-up." ))
//====================================================
// TARGET DECAY
//====================================================
int targetDecayBars = (input.int( 20, "Target decay bars", minval = 5, tooltip = "20 x 3m = 60 minutes" ))
//====================================================
// RECYCLE PROFITS
//====================================================
int recycleMinTicks = (input.int( 12, "Overlay recycle minimum ticks", minval = 4 ))
float recycleTPATR = (input.float( 0.12, "Overlay recycle ATR", minval = 0.04, step = 0.02 ))
int baseRotateMinTicks = (input.int( 10, "Base rotation minimum ticks", minval = 2 ))
float baseRotateATR = (input.float( 0.15, "Base rotation ATR", minval = 0.05, step = 0.05 ))
float coreTPATR = (input.float( 0.60, "Flat-reset core TP ATR", minval = 0.10, step = 0.05 ))
//====================================================
// UNDERWATER / REPAIR
//====================================================
int repairLookback = (input.int( 5, "Repair rebound lookback", minval = 2 ))
int overlayRepairSellTicks = (input.int( 8, "Overlay underwater rebound ticks", minval = 4 ))
float overlayRepairSellATR = (input.float( 0.08, "Overlay underwater rebound ATR", minval = 0.02, step = 0.02 ))
int baseRepairSellTicks = (input.int( 16, "Base underwater rebound ticks", minval = 6 ))
float baseRepairSellATR = (input.float( 0.20, "Base underwater rebound ATR", minval = 0.05, step = 0.05 ))
int lowerRebuyTicks = (input.int( 10, "Lower REBUY gap ticks", minval = 4 ))
float lowerRebuyATR = (input.float( 0.10, "Lower REBUY gap ATR", minval = 0.02, step = 0.02 ))
int repairLifeBars = (input.int( 20, "Repair opportunity bars", minval = 1 ))
float abandonRepairStrengthATR = (input.float( 0.15, "Cancel repair after strength ATR", minval = 0.05, step = 0.05 ))
//====================================================
// V5.3 CONTROLLED UPSIDE-DRIFT BIAS / LOCATION
//
// This is intentional, bounded structural bias rather than
// unrestricted parameter fitting. Defaults favor long exposure
// when price is statistically low and has started to reclaim.
//====================================================
bool controlledUpsideBias = (input.bool( true, "Controlled upside-drift bias" ))
bool useVWAPLocationBias = (input.bool( true, "Use RTH VWAP location / reclaim" ))
bool useRangeLocationBias = (input.bool( true, "Use 60m / session / 5D range location" ))
float driftVWAPDeepSigma = (input.float( 1.50, "Deep VWAP lower band sigma", minval = 0.50, maxval = 3.00, step = 0.25 ))
float driftVWAPExtremeSigma = (input.float( 2.00, "Extreme VWAP lower band sigma", minval = 1.00, maxval = 4.00, step = 0.25 ))
float driftRangeLowPct = (input.float( 0.25, "60m / session low-zone fraction", minval = 0.10, maxval = 0.45, step = 0.05 ))
float driftFiveDayLowPct = (input.float( 0.30, "5D RTH low-zone fraction", minval = 0.10, maxval = 0.50, step = 0.05 ))
int driftMinLocationScore = (input.int( 2, "Minimum multi-TF dip score", minval = 1, maxval = 4 ))
bool protectCoreBase = (input.bool( true, "Protect Base Goal as core long inventory" ))
//====================================================
// V5.3 PAIRED REPAIR GATES
//====================================================
bool useOneRepairSlot = (input.bool( true, "One REPAIR_SELL per pending repair" ))
bool useRepairLocationGate = (input.bool( true, "Block repair SELL in lower-location zones" ))
float repairMinVWAPZ = (input.float( -1.00, "Repair SELL minimum VWAP z-score", minval = -3.00, maxval = 1.00, step = 0.25 ))
float repairMin60Pos = (input.float( 0.35, "Repair SELL minimum 60m range position", minval = 0.10, maxval = 0.80, step = 0.05 ))
float repairMinSessionPos = (input.float( 0.30, "Repair SELL minimum session range position", minval = 0.10, maxval = 0.80, step = 0.05 ))
int failedRepairRestoreTicks = (input.int( 8, "Failed repair higher restore ticks", minval = 2, maxval = 40 ))
float failedRepairRestoreATR = (input.float( 0.08, "Failed repair higher restore ATR", minval = 0.02, maxval = 1.00, step = 0.02 ))
//====================================================
// CORE ROTATION
//====================================================
bool allowCoreRotation = (input.bool( true, "Allow underwater CORE rotation" ))
int coreRotationAgeBars = (input.int( 20, "Core rotation minimum age", minval = 1 ))
float coreRotationMinLoss = (input.float( 250, "Core rotation minimum open loss $", minval = 0 ))
//====================================================
// OPTIONAL EMERGENCY
//====================================================
bool emergencyEnabled = (input.bool( false, "Emergency catastrophic exit" ))
float emergencyLossDollar = (input.float( 15000, "Emergency open loss $", minval = 500 ))
//====================================================
// DISPLAY
//====================================================
bool showDashboard = (input.bool( true, "Show dashboard" ))
bool showTradeMarkers = (input.bool( true, "Show custom BUY / SELL fill markers" ))
bool showOrderMarkers = (input.bool( false, "Show order-created markers" ))
//====================================================
// NATIVE 3M ONLY
//====================================================
if (barstate.isfirst and timeframe.in_seconds() != 180)
    runtime.error(
         "TEST43 V5.3.1 requires native 3-minute MES chart."
    )
//====================================================
// SESSION CLOCK
//====================================================
bool inRTH = (not na( time( timeframe.period, rthSession, "America/New_York" ) ))
bool newRTH = (inRTH and not inRTH[1])
int hh = (hour( time, "America/New_York" ))
int mm = (minute( time, "America/New_York" ))
bool buyWindow = (inRTH and ( hh < 15 or ( hh == 15 and mm <= 54 ) ))
bool closesAt1600 = (hour( time_close, "America/New_York" ) == 16 and minute( time_close, "America/New_York" ) == 0)
bool trimDecisionBar = (hour( time_close, "America/New_York" ) == 16 and minute( time_close, "America/New_York" ) == 12)
bool inOpeningRangeWindow = (inRTH and hh == 9 and mm < 45)
bool openingRangeReady = (inRTH and ( hh > 9 or ( hh == 9 and mm >= 45 ) ))
//====================================================
// BASIC INDICATORS
//====================================================
float atr = (ta.atr(14))
float rsi2 = (ta.rsi( close, 2 ))
float wr2 = (ta.wpr( 2 ))
bool rsiExtreme = (rsi2 <= rsiExtremeLevel)
bool wrExtreme = (wr2 <= wrExtremeLevel)
bool rsiTurnUp = (rsi2 > rsi2[1] and rsi2[1] <= rsiExtremeLevel)
bool wrTurnUp = (wr2 > wr2[1] and wr2[1] <= wrExtremeLevel)
//====================================================
// RTH-ONLY ROLLING ARRAYS
//
// Current bar is pushed only AFTER all signal logic.
// Therefore these levels always use prior completed RTH bars.
//====================================================
var array<float> rthHighs = (array.new_float())
var array<float> rthLows = (array.new_float())
var array<float> completedRTHHighs = (array.new_float())
var array<float> completedRTHLows = (array.new_float())
f_lastMax(
     array<float> xs,
     int n
) =>
    float result = (na)
    int sz = (array.size( xs ))
    int count = (math.min( sz, n ))
    if (count > 0)
        for i = sz - count to sz - 1
            float v = (array.get( xs, i ))
            result := (na( result ) ? v : math.max( result, v ))
    result
f_lastMin(
     array<float> xs,
     int n
) =>
    float result = (na)
    int sz = (array.size( xs ))
    int count = (math.min( sz, n ))
    if (count > 0)
        for i = sz - count to sz - 1
            float v = (array.get( xs, i ))
            result := (na( result ) ? v : math.min( result, v ))
    result
//====================================================
// PRIOR RTH / CURRENT RTH / OPENING RANGE
//====================================================
var float priorRTHHigh = (na)
var float priorRTHLow = (na)
var float currentRTHHigh = (na)
var float currentRTHLow = (na)
var float openingRangeHigh = (na)
var float openingRangeLow = (na)
//====================================================
// NEW RTH PREP
//====================================================
if (newRTH)
    if (not na( currentRTHHigh ))
        priorRTHHigh := (currentRTHHigh)
        priorRTHLow := (currentRTHLow)
        array.push(
             completedRTHHighs,
             currentRTHHigh
        )
        array.push(
             completedRTHLows,
             currentRTHLow
        )
        if (array.size( completedRTHHighs ) > 4)
            array.shift(
                 completedRTHHighs
            )
            array.shift(
                 completedRTHLows
            )
    currentRTHHigh := (high)
    currentRTHLow := (low)
    openingRangeHigh := (high)
    openingRangeLow := (low)
    array.clear(
         rthHighs
    )
    array.clear(
         rthLows
    )
else if (inRTH)
    currentRTHHigh := (na( currentRTHHigh ) ? high : math.max( currentRTHHigh, high ))
    currentRTHLow := (na( currentRTHLow ) ? low : math.min( currentRTHLow, low ))
    if (inOpeningRangeWindow)
        openingRangeHigh := (na( openingRangeHigh ) ? high : math.max( openingRangeHigh, high ))
        openingRangeLow := (na( openingRangeLow ) ? low : math.min( openingRangeLow, low ))
//====================================================
// V5.3 RTH VWAP + VOLUME-WEIGHTED SIGMA
//
// Custom RTH-only VWAP avoids mixing the overnight session into
// the 09:30-16:00 location model. Current-bar values are known only
// at the completed-bar decision point; reclaim uses the prior band.
//====================================================
var float rthCumVolume = (0.0)
var float rthCumPV = (0.0)
var float rthCumP2V = (0.0)
float vwapSource = (hlc3)
if (newRTH)
    rthCumVolume := (volume)
    rthCumPV := (volume * vwapSource)
    rthCumP2V := (volume * vwapSource * vwapSource)
else if (inRTH)
    rthCumVolume += (volume)
    rthCumPV += (volume * vwapSource)
    rthCumP2V += (volume * vwapSource * vwapSource)
float rthVWAP = (( inRTH and rthCumVolume > 0 ) ? rthCumPV / rthCumVolume : na)
float rthVWAPVariance = (( inRTH and rthCumVolume > 0 and not na( rthVWAP ) ) ? math.max( rthCumP2V / rthCumVolume - rthVWAP * rthVWAP, 0 ) : na)
float rthVWAPStd = (not na( rthVWAPVariance ) ? math.sqrt( rthVWAPVariance ) : na)
float vwapLowerDeep = (( not na( rthVWAP ) and not na( rthVWAPStd ) ) ? rthVWAP - rthVWAPStd * driftVWAPDeepSigma : na)
float vwapLowerExtreme = (( not na( rthVWAP ) and not na( rthVWAPStd ) ) ? rthVWAP - rthVWAPStd * driftVWAPExtremeSigma : na)
float vwapZ = (( not na( rthVWAP ) and not na( rthVWAPStd ) and rthVWAPStd > syminfo.mintick ) ? ( close - rthVWAP ) / rthVWAPStd : 0.0)
//====================================================
// RTH-ONLY ROLLING LEVELS
//====================================================
float roll15High = (inRTH ? f_lastMax( rthHighs, 5 ) : na)
float roll15Low = (inRTH ? f_lastMin( rthLows, 5 ) : na)
float roll30High = (inRTH ? f_lastMax( rthHighs, 10 ) : na)
float roll30Low = (inRTH ? f_lastMin( rthLows, 10 ) : na)
float roll60High = (inRTH ? f_lastMax( rthHighs, 20 ) : na)
float roll60Low = (inRTH ? f_lastMin( rthLows, 20 ) : na)
//====================================================
// V5.3 CURRENT 5-RTH-SESSION ROLLING RANGE
//
// Current RTH + four completed RTH sessions. No future daily or
// weekly bar is used.
//====================================================
float prior4RTHHigh = (f_lastMax( completedRTHHighs, 4 ))
float prior4RTHLow = (f_lastMin( completedRTHLows, 4 ))
float roll5DHigh = (inRTH ? ( na( prior4RTHHigh ) ? currentRTHHigh : math.max( currentRTHHigh, prior4RTHHigh ) ) : na)
float roll5DLow = (inRTH ? ( na( prior4RTHLow ) ? currentRTHLow : math.min( currentRTHLow, prior4RTHLow ) ) : na)
//====================================================
// RANGE POSITION
//====================================================
f_rangePos(
     float px,
     float lo,
     float hi
) =>
    float width = (hi - lo)
    width > syminfo.mintick ? (px - lo) / width : 0.50
float posPriorRTH = (not na( priorRTHLow ) and not na( priorRTHHigh ) ? f_rangePos( close, priorRTHLow, priorRTHHigh ) : 0.50)
float posOpening = (openingRangeReady and not na( openingRangeLow ) and not na( openingRangeHigh ) ? f_rangePos( close, openingRangeLow, openingRangeHigh ) : 0.50)
float pos15 = (not na( roll15Low ) and not na( roll15High ) ? f_rangePos( close, roll15Low, roll15High ) : 0.50)
float pos30 = (not na( roll30Low ) and not na( roll30High ) ? f_rangePos( close, roll30Low, roll30High ) : 0.50)
float pos60 = (not na( roll60Low ) and not na( roll60High ) ? f_rangePos( close, roll60Low, roll60High ) : 0.50)
float posCurrentRTH = (( inRTH and not na( currentRTHLow ) and not na( currentRTHHigh ) ) ? f_rangePos( close, currentRTHLow, currentRTHHigh ) : 0.50)
float pos5D = (( inRTH and not na( roll5DLow ) and not na( roll5DHigh ) ) ? f_rangePos( close, roll5DLow, roll5DHigh ) : 0.50)
//====================================================
// REVERSAL LOCATION
//====================================================
bool nearPriorRTHLow = (inRTH and not na( priorRTHLow ) and posPriorRTH <= bottomRangePct)
bool nearOpeningLow = (openingRangeReady and posOpening <= bottomRangePct)
bool near15Low = (inRTH and not na( roll15Low ) and pos15 <= bottomRangePct)
bool near30Low = (inRTH and not na( roll30Low ) and pos30 <= bottomRangePct)
bool near60Low = (inRTH and not na( roll60Low ) and pos60 <= bottomRangePct)
//====================================================
// FAILED LOW BREAKDOWNS
//====================================================
bool failedPriorRTHLow = (inRTH and not na( priorRTHLow ) and low < priorRTHLow and close > priorRTHLow)
bool failedOpeningLow = (openingRangeReady and not na( openingRangeLow ) and low < openingRangeLow and close > openingRangeLow)
bool failed15Low = (inRTH and not na( roll15Low ) and low < roll15Low and close > roll15Low)
bool failed30Low = (inRTH and not na( roll30Low ) and low < roll30Low and close > roll30Low)
bool failed60Low = (inRTH and not na( roll60Low ) and low < roll60Low and close > roll60Low)
bool anyFailedLowBreak = (failedPriorRTHLow or failedOpeningLow or failed15Low or failed30Low or failed60Low)
//====================================================
// FAILED HIGH BREAKOUTS
//====================================================
bool failedPriorRTHHigh = (inRTH and not na( priorRTHHigh ) and high > priorRTHHigh and close < priorRTHHigh)
bool failedOpeningHigh = (openingRangeReady and not na( openingRangeHigh ) and high > openingRangeHigh and close < openingRangeHigh)
bool failed15High = (inRTH and not na( roll15High ) and high > roll15High and close < roll15High)
bool failed30High = (inRTH and not na( roll30High ) and high > roll30High and close < roll30High)
bool failed60High = (inRTH and not na( roll60High ) and high > roll60High and close < roll60High)
bool anyFailedHighBreak = (failedPriorRTHHigh or failedOpeningHigh or failed15High or failed30High or failed60High)
//====================================================
// RANGE SCORE
//====================================================
int rangeScore = (0)
rangeScore += (( nearPriorRTHLow or failedPriorRTHLow ) ? 1 : 0)
rangeScore += (( nearOpeningLow or failedOpeningLow ) ? 1 : 0)
rangeScore += (( near15Low or failed15Low ) ? 1 : 0)
rangeScore += (( near30Low or failed30Low ) ? 1 : 0)
rangeScore += (( near60Low or failed60Low ) ? 1 : 0)
bool evidenceLocation = (inRTH and rangeScore >= 1)
//====================================================
// RETEST
//====================================================
float retestTolerance = (atr * 0.10)
bool rangeRetest = (inRTH and ( ( not na( roll15Low ) and low <= roll15Low + retestTolerance ) or ( not na( roll30Low ) and low <= roll30Low + retestTolerance ) or ( openingRangeReady and not na( openingRangeLow ) and low <= openingRangeLow + retestTolerance ) ))
//====================================================
// RTH DOWN PUSHES
//====================================================
var int downPushes = (0)
var float previousPushLow = (na)
if (newRTH)
    downPushes := (0)
